###############################################################################
# Quiz Platform — environment template
#
# Copy to `.env` in the repo root. Never commit real credentials — the repo
# ships this template only; no keys are stored in git.
#
# Load order (highest precedence first):
#   1. variables already set in the environment (CI / hosting platform)
#   2. `.env.local`  — machine-specific overrides, gitignored
#   3. `.env`        — this file, shared configuration
#
# Database (Turso Cloud — https://orm.drizzle.team/docs/get-started/turso-new):
#   1. Create a database:  turso db create quizplatform
#   2. Read the URL:       turso db show quizplatform --url
#   3. Mint a token:       turso db tokens create quizplatform
#   4. Apply the schema:   bun run db:migrate    (drizzle-kit migrate)
#   5. Seed demo data:     bun run db:seed       (optional)
#
# These two variables are required — the application talks to Turso Cloud only.
###############################################################################

# libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"

# turso db tokens create <db-name>
TURSO_AUTH_TOKEN=""

# Accepted as an alias for TURSO_DATABASE_URL
# DATABASE_URL=""

# Hono API
API_PORT=3001

# Public origin of the Next.js app (used for CORS when calling the API directly)
WEB_ORIGIN="http://localhost:3000"

# Where the Next.js dev server proxies /api/* — internal, never exposed to the browser
API_INTERNAL_URL="http://localhost:3001"

# Signing secret for the httpOnly session JWT (Day 2 auth).
# Generate one with:  openssl rand -base64 48
# Required in production (minimum 32 characters). When it is unset locally the
# API falls back to an insecure development secret and prints a warning.
# JWT_SECRET=""

# ── Deployment (Day 14) ───────────────────────────────────────────────────────
# Everything below has a safe default; set it only to change the shipped policy.
# `bun run deploy:check` reports the effective values without starting anything.

# Production must set this — the platforms do it for you, Docker does it for you.
# NODE_ENV="production"

# Failed sign-in attempts allowed per IP per window (0 disables the limiter).
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT_MAX=10

# Largest accepted request body. Bounds: 1 KB – 5 MB.
# MAX_BODY_BYTES=65536

# Publish the seeded demo logins on the landing page and in the API's /api/landing
# payload. On by default because this is a demo platform; set to 0 on a real
# deployment so a public page never advertises a way in.
# DEMO_ACCOUNTS=1

# Only for a split deployment where the browser calls a *different* API origin.
# Leave empty in the default setup: the web app proxies /api/* internally, so the
# browser only ever talks to the web origin (and the cookie stays first-party).
# NEXT_PUBLIC_API_BASE_URL=""
