###############################################################################
# Quiz Platform — environment template
#
# Copy to `.env` in the repo root. Never commit real credentials.
#
# Load order (highest precedence first):
#   1. variables already set in the environment (CI / hosting platform)
#   2. `.env.local`  — machine-specific overrides, gitignored
#   3. `.env`        — this file, shared configuration
#
# Database (Turso Cloud — https://orm.drizzle.team/docs/get-started/turso-new):
#   1. Create a database:  turso db create quizplatform
#   2. Read the URL:       turso db show quizplatform --url
#   3. Mint a token:       turso db tokens create quizplatform
#   4. Apply the schema:   pnpm db:migrate    (drizzle-kit migrate)
#   5. Seed demo data:     pnpm db:seed
#
# These two variables are required — the application talks to Turso Cloud only.
###############################################################################

# libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"

# turso db tokens create <db-name>
TURSO_AUTH_TOKEN=""

# Accepted as an alias for TURSO_DATABASE_URL
# DATABASE_URL=""

# Hono API
API_PORT=3001

# Public origin of the Next.js app (used for CORS when calling the API directly)
WEB_ORIGIN="http://localhost:3000"

# Where the Next.js dev server proxies /api/* — internal, never exposed to the browser
API_INTERNAL_URL="http://localhost:3001"

# Signing secret for Day 2 auth cookies (generate: openssl rand -base64 48)
# JWT_SECRET="change-me"
