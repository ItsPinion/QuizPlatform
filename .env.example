###############################################################################
# Quiz Platform — environment template
#
# Copy to `.env` (repo root) or `apps/api/.env`. Never commit real credentials.
#
# Database (Turso):
#   1. Create a database:  https://turso.tech  (or `turso db create quizplatform`)
#   2. Copy the libsql:// URL below and generate a token:
#        turso db tokens create quizplatform
#   3. Apply the schema:    pnpm db:migrate
#   4. Seed demo data:      pnpm db:seed
#
# Leave DATABASE_URL unset during development to use the local SQLite file at
# `.data/quizplatform.db` (gitignored) with the exact same schema and scripts.
###############################################################################

# libsql://<db-name>-<org>.turso.io
# DATABASE_URL="libsql://quizplatform-yourorg.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Hono API
API_PORT=3001

# Public origin of the Next.js app (used for CORS when calling the API directly)
WEB_ORIGIN="http://localhost:3000"

# Where the Next.js dev server proxies /api/* — internal, never exposed to the browser
API_INTERNAL_URL="http://localhost:3001"

# Signing secret for Day 2 auth cookies (generate: openssl rand -base64 48)
# JWT_SECRET="change-me"
