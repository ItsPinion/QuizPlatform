{
  "name": "quizplatform",
  "version": "0.1.0",
  "private": true,
  "description": "Quiz Management & Online Assessment Platform \u2014 Turborepo monorepo (Next.js + Hono RPC + Drizzle/Turso)",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11",
    "bun": ">=1.1"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "@tailwindcss/oxide",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@quiz/web",
    "dev:api": "turbo run dev --filter=@quiz/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@quiz/db",
    "db:migrate": "turbo run db:migrate --filter=@quiz/db",
    "db:push": "turbo run db:push --filter=@quiz/db",
    "db:studio": "turbo run db:studio --filter=@quiz/db",
    "db:seed": "turbo run db:seed --filter=@quiz/db"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
