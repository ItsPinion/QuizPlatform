{
  "name": "@quiz/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./env": "./src/env.ts",
    "./load-env": "./src/load-env.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:status": "tsx src/status.ts",
    "test": "vitest run",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@quiz/shared": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
